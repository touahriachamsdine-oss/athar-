{
    "buildCommand": "node build.js",
    "outputDirectory": "public",
    "rewrites": [
        {
            "source": "/",
            "destination": "/pages/index.html"
        },
        {
            "source": "/((?!src|public|pages|api).*)\\.html",
            "destination": "/pages/$1.html"
        },
        {
            "source": "/((?!src|public|pages|api|manifest\\.json|vercel\\.json).*)",
            "destination": "/pages/$1"
        }
    ],
    "headers": [
        {
            "source": "/public/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "no-referrer"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=()"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://ep-silent-bread-aqt1uezw.neonauth.c-8.us-east-1.aws.neon.tech https://ep-silent-bread-aqt1uezw.apirest.c-8.us-east-1.aws.neon.tech; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
                }
            ]
        }
    ]
}